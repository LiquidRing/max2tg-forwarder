# --- Telegram ---
# Токен бота из @BotFather. У бота должен быть выключен privacy mode
# (@BotFather -> Bot Settings -> Group Privacy -> Turn off),
# иначе бот не увидит сообщения в группе.
TG_BOT_TOKEN=123456:AA...

# Кто может управлять мостом (/bind, /unbind, /chats). Список через запятую.
# Свой идентификатор можно узнать командой /id. Если пусто — команды доступны всем.
TG_ADMIN_IDS=

# --- MAX ---
# Тип устройства для сессии MAX: WEB | ANDROID | DESKTOP
MAX_DEVICE_TYPE=WEB
# Суффикс имени токена в tokens.json (нужен, если запускаете несколько аккаунтов).
MAX_TOKEN_SUFFIX=
# Пароль, если на аккаунте MAX включена двухфакторная защита.
MAX_PASSWORD=
# Пересылать в Telegram сообщения, написанные вами из клиента MAX.
MAX_FORWARD_OWN_MESSAGES=true

# --- Хранилище ---
DATABASE_URL=sqlite+aiosqlite:///./max2tg.sqlite3
# Каталог, в котором лежат база и tokens.json.
STATE_DIR=.

# --- Лимиты вложений (в байтах) ---
TG_DOWNLOAD_LIMIT=20971520
TG_UPLOAD_LIMIT=52428800
MAX_UPLOAD_LIMIT=2147483648
# Предел длины одного сообщения в MAX (длиннее — режется на части).
MAX_TEXT_LIMIT=3000

# --- Троттлинг (запросов в секунду) ---
TG_GLOBAL_RATE=25
TG_CHAT_RATE=1
MAX_GLOBAL_RATE=4
MAX_CHAT_RATE=1

# --- Прочее ---
# Сколько секунд ждать остальные части альбома в Telegram.
MEDIA_GROUP_DELAY=1.0
LOG_LEVEL=INFO
# Перенос форматирования Telegram -> MAX: elements | tags | plain
TG_TO_MAX_FORMATTING=elements

# Прокси для Telegram Bot API (например http://127.0.0.1:3067).
# Если не задан, берётся из HTTPS_PROXY / HTTP_PROXY / ALL_PROXY окружения.
TG_PROXY=

# --- Пользовательская сессия Telegram (для /sync — создания групп и папки) ---
# api_id и api_hash берутся на https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=
TG_PHONE=+79990000000
# Имя файла сессии Telethon (создаётся командой `uv run max2tg login`).
TG_SESSION=telegram_user
# Название папки, в которую складываются группы моста.
TG_FOLDER_NAME=MAX (СКАМ)
# Сколько групп создавать за один вызов /sync и пауза между созданиями.
SYNC_GROUP_LIMIT=20
SYNC_CREATE_DELAY=3.0
# Прокси для MTProto-сессии (Telethon). Если пусто — берётся TG_PROXY, затем окружение.
TG_USERBOT_PROXY=
# Пауза перед сменой аватара группы (Telegram ограничивает это жёстче отправки).
SYNC_AVATAR_DELAY=2.0
# Сколько последних сообщений чата MAX переносить при первой привязке (0 — не переносить).
HISTORY_IMPORT_LIMIT=100
# Пауза между сообщениями при переносе истории (защищает соединение с MAX).
HISTORY_IMPORT_DELAY=0.4

# --- Многопользовательский режим ---
# Ключ шифрования чужих токенов MAX и сессий Telegram. Задайте длинную строку.
MASTER_KEY=
# Разрешить подключаться посторонним пользователям (иначе только TG_ADMIN_IDS).
ALLOW_PUBLIC_SIGNUP=true
# Сколько аккаунтов MAX может подключить один пользователь.
MAX_ACCOUNTS_PER_USER=3
